; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ProjectHarbor"
run/main_scene="uid://cedaxghwmb824"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://Scripts/autoload/event_bus.gd"
SettingsManager="*res://Scripts/autoload/settings_manager.gd"
PortManager="*res://Scripts/autoload/port_manager.gd"
FleetManager="*res://Scripts/autoload/fleet_manager.gd"
EconomyManager="*res://Scripts/autoload/economy_manager.gd"
MissionManager="*res://Scripts/autoload/mission_manager.gd"
CompanyManager="*res://Scripts/autoload/company_manager.gd"
GameManager="*res://Scripts/GameManager.gd"
SaveManager="*res://Scripts/autoload/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
